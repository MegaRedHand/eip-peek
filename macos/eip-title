#!/bin/zsh
# eip-title: look up the title, description and upgrade status of the first
# EIP/ERC number in $1 (or stdin).
#
# Checks forkcast's EIP index first, since it carries EIPs still sitting in a PR
# that eips.ethereum.org doesn't list, then falls back to eips.ethereum.org
# (which also redirects ERC numbers). Older EIPs predate the description field,
# so they come back with a title only.
#
# The upgrade status ("Scheduled for Glamsterdam (headliner)") is forkcast's
# alone: the current stage in each network upgrade forkcast tracks the EIP for,
# newest upgrade first.
#
# Caches, under ~/Library/Caches/eip-title/:
#   forkcast-eips.json  forkcast's whole index, refreshed daily
#   eips/<N>            one eips.ethereum.org result, kept for a week. Misses
#                       aren't cached, so a newly published EIP shows up at once
#
# Usage: eip-title [--hud | --json] [text]
#   (none)  print the title, then the description, status and URL when known
#   --hud   show the result in a label next to the cursor (Quick Action mode);
#           see eip-hud.swift
#   --json  print {title, description, status, url}, empty strings when unknown

set -u

mode=text
case ${1:-} in
  --hud) mode=hud; shift ;;
  --json) mode=json; shift ;;
esac

# Decodes the HTML entities eips.ethereum.org uses in its <title> and meta tags.
decode() {
  sed -e 's/&quot;/"/g' -e "s/&#39;/'/g" -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&amp;/\&/g'
}

input=${1:-$(cat)}
num=$(print -r -- "$input" | grep -oE '[0-9]+' | head -1)

title=""
description=""
upgrade_status=""
url=""
if [[ -z $num || ${#num} -gt 6 ]]; then
  title="No EIP number in selection: ${input[1,40]}"
else
  num=$((10#$num))

  cache_dir=~/Library/Caches/eip-title
  index=$cache_dir/forkcast-eips.json
  site_cache=$cache_dir/eips/$num
  mkdir -p $cache_dir/eips

  # forkcast's whole index is one file, so cache it and refresh it daily.
  if [[ ! -s $index || -n $(find $index -mtime +0) ]]; then
    curl -fsS -m 10 https://forkcast.org/api/eips.json -o $index.tmp \
      && mv $index.tmp $index \
      || rm -f $index.tmp
  fi

  if [[ -s $index ]]; then
    # Three lines (title, description, status); nothing when forkcast lacks the EIP.
    { read -r title; read -r description; read -r upgrade_status } < <(
      /usr/bin/jq -r --argjson n $num '
        .eips[] | select(.id == $n)
        | .title,
          (.description // "" | gsub("\\s+"; " ")),
          # Upgrades are listed oldest first; the last history entry is the current stage.
          ([.forkRelationships // [] | .[] | select(.statusHistory // [] | length > 0)
            | "\(.statusHistory[-1].status) for \(.forkName)\(if .isHeadliner then " (headliner)" else "" end)"]
           | reverse | join(" · "))
      ' $index
    )
    url=https://forkcast.org/eips/$num
  fi

  if [[ -z $title ]]; then
    url=https://eips.ethereum.org/EIPS/eip-$num
    # A stale entry is refreshed, but kept if the refresh fails.
    if [[ ! -s $site_cache || -n $(find $site_cache -mtime +6) ]]; then
      page=$(curl -fsL -m 10 $url)
      t=$(print -r -- "$page" | sed -n 's:.*<title>\(.*\)</title>.*:\1:p' | head -1 | decode)
      d=$(print -r -- "$page" | sed -n 's:.*<meta name="description" content="\([^"]*\)".*:\1:p' | head -1 | decode)
      [[ -n $t ]] && print -rl -- "$t" "$d" > $site_cache
    fi
    [[ -s $site_cache ]] && { read -r title; read -r description } < $site_cache
  fi

  if [[ -z $title ]]; then
    title="EIP-$num: not found on forkcast or eips.ethereum.org"
    url=""
  fi
fi

case $mode in
  text)
    print -r -- "$title"
    [[ -n $description ]] && print -r -- "$description"
    [[ -n $upgrade_status ]] && print -r -- "$upgrade_status"
    [[ -n $url ]] && print -r -- "$url"
    exit 0
    ;;
  json)
    /usr/bin/jq -nc --arg title "$title" --arg description "$description" \
      --arg status "$upgrade_status" --arg url "$url" '$ARGS.named'
    exit 0
    ;;
esac

# Replace a label still on screen from a previous lookup, then detach so the
# Quick Action finishes right away instead of running until the label closes.
pkill -x eip-hud 2>/dev/null
~/.local/bin/eip-hud "$title" "$url" "$description" "$upgrade_status" </dev/null >/dev/null 2>&1 &!
