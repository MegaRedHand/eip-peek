{
  "manifest_version": 3,
  "name": "EIP Title",
  "version": "0.1.0",
  "description": "Double-click an EIP/ERC number to see its title (forkcast.org, then eips.ethereum.org).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://forkcast.org/*",
    "https://eips.ethereum.org/*"
  ],
  "permissions": [
    "storage"
  ]
}
